# Glass backend configuration. Copy this file to `.env` (gitignored) and
# fill in real values. Never commit `.env`.

# Port the Glass backend (server.js) listens on. This process also serves
# the static frontend (index.html/script.js/style.css).
PORT=4000

# Base URL of the Nexora dashboard/API this Glass store connects to.
# Must match the `apiBase` already configured in index.html's Nexora.init().
NEXORA_API_BASE=http://localhost:3001

# This store's Nexora store id (same value as `storeId` in index.html's
# Nexora.init() — find it on the store's page in the Nexora dashboard).
NEXORA_STORE_ID=

# Secret API key for the store's "Nexora API" integration (nx_live_...).
# Get it from: Nexora dashboard -> Integrations -> Nexora API -> Generate
# new key. Shown once — copy it immediately. Server-side only, NEVER put
# this in index.html/script.js or any browser-visible code.
NEXORA_API_KEY=

# HMAC signing secret for the store's "Nexora Webhooks" integration. Get it
# from: Nexora dashboard -> Store page -> Disconnect "Nexora Webhooks" (if
# already set up with no secret on hand) -> Integrations -> Nexora Webhooks
# -> Set Up, which shows the webhook secret once. Server-side only.
NEXORA_WEBHOOK_SECRET=

# Secret Nexora generates for the REVERSE direction: it lets Nexora prove
# to THIS backend that a GET /api/nexora/products request genuinely came
# from Nexora, so it's willing to hand back the real product catalog. Get
# it from: Nexora dashboard -> this store's "Nexora Webhooks" integration ->
# set the outbound webhook URL to this backend's own public
# /api/nexora/products address -> Nexora shows this secret once. Until this
# is set, GET /api/nexora/products rejects every request (401) rather than
# leaking the catalog to an unverified caller.
NEXORA_OUTBOUND_SECRET=

# Shared token that protects GET /api/nexora/health (this Glass backend's
# own developer-only status endpoint). Pick any long random string; send it
# as `Authorization: Bearer <token>` when checking status. Leave blank to
# keep the endpoint disabled.
GLASS_DEV_TOKEN=
